  "workbench.editor.empty.hint": "hidden",
  "lmstudioProxy.autoStart": false,
  "githubPullRequests.pullRequestDescription": "Copilot",
  "files.dialog.defaultPath": "D:\\c0dex\\GitHub",
  "window.restoreWindows": "none"
